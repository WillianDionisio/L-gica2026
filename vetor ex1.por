programa {
  funcao inicio() {
    cadeia diasSemana[7]
    diasSemana[0]="Domingo"
    diasSemana[1]="Seguda-feira"
    diasSemana[2]="Terça-feira"
    diasSemana[3]="Quarta-feira"
    diasSemana[4]="Quinta-feira"
    diasSemana[5]="Sexta-feira"
    diasSemana[6]="Sábado"
    
    para(inteiro i=0;i<7;i++){
      escreva(diasSemana[i],"\n")
    }
  }
}
