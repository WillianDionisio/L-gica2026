programa {
  funcao inicio() {
    cadeia nome
    real nota1
    real nota2
    real media
    escreva("Digite o nome do aluno: ")
    leia(nome)
    escreva("Digite a primeira nota: ")
    leia(nota1)
    escreva("Digite a seguda nota: ")
    leia(nota2)
    media=(nota1+nota2)/2
    escreva(nome," sua média é: ",media)
  }
}
