programa {
  funcao inicio() {
    inteiro num1
    inteiro num2
    inteiro resultado
    escreva("Digite o primeiro número para a soma: ")
    leia(num1)
    escreva("Digite o segundo número para a soma ")
    leia(num2)
    resultado=num1+num2
    escreva("O resultado da soma é: ",resultado)

  }
}
